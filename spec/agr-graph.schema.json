{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticgraphs.dev/spec/agr-graph.schema.json",
  "title": "AGR Graph v1.5",
  "type": "object",
  "required": [
    "apiVersion",
    "name",
    "description",
    "category",
    "nodes",
    "edges",
    "termination"
  ],
  "properties": {
    "apiVersion": {
      "enum": [
        "agr/v1",
        "agr/v1.1",
        "agr/v1.2",
        "agr/v1.3",
        "agr/v1.4",
        "agr/v1.5"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "category": {
      "enum": [
        "software-engineering",
        "devops-sre",
        "data-analytics",
        "research-knowledge",
        "content-marketing",
        "business-ops",
        "finance",
        "legal-compliance",
        "healthcare-science",
        "education",
        "customer-support-sales",
        "security",
        "hr-people",
        "logistics-retail",
        "creative-production"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "speciality"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$",
            "description": "A dot is reserved for subgraph expansion (`phase.child-node`); authored ids should not contain one."
          },
          "speciality": {
            "type": "string"
          },
          "abilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "enum": [
              "agent",
              "verifier",
              "human",
              "router",
              "subgraph",
              "search"
            ],
            "default": "agent"
          },
          "parallel_group": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
            "description": "v1.1 \u2014 <category>/<graph-name> inlined at load time when kind is subgraph."
          },
          "join": {
            "type": "string",
            "pattern": "^(any|all|quorum\\([1-9][0-9]*\\))$",
            "default": "any",
            "description": "v1.1 \u2014 readiness rule over resolved incoming flow edges."
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "v1.1 \u2014 blackboard keys this node reads."
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "v1.1 \u2014 blackboard keys this node is contracted to write."
          },
          "on_error": {
            "type": "string",
            "description": "v1.1 \u2014 node id to route to when this node emits `error`; sugar for an error edge."
          },
          "retries": {
            "type": "object",
            "properties": {
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5,
                "description": "Re-runs on error before error edges fire. Enforced."
              }
            },
            "required": [
              "max"
            ],
            "additionalProperties": false
          },
          "approval": {
            "type": "object",
            "properties": {
              "contract": {
                "type": "string"
              },
              "on_timeout": {
                "enum": [
                  "escalate",
                  "reject",
                  "proceed"
                ],
                "default": "escalate",
                "description": "Recorded for the host that owns the clock; the harness has none and never claims to enforce it."
              }
            },
            "required": [
              "contract"
            ],
            "additionalProperties": false
          },
          "fan_out": {
            "type": "object",
            "required": [
              "over"
            ],
            "additionalProperties": false,
            "description": "v1.2 \u2014 run this node once per element of the named blackboard list.",
            "properties": {
              "over": {
                "type": "string"
              },
              "max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "default": 40
              },
              "on_partial": {
                "type": "string",
                "enum": [
                  "continue",
                  "fail"
                ],
                "default": "continue"
              }
            }
          },
          "aggregate": {
            "type": "object",
            "required": [
              "op",
              "over"
            ],
            "additionalProperties": false,
            "description": "v1.2 \u2014 reduce a fanned-out list before this node runs.",
            "properties": {
              "op": {
                "enum": [
                  "majority",
                  "median",
                  "union",
                  "best"
                ]
              },
              "over": {
                "type": "string"
              },
              "tie_break": {
                "type": "string"
              }
            }
          },
          "search": {
            "type": "object",
            "required": [
              "score"
            ],
            "additionalProperties": false,
            "description": "v1.2 \u2014 bounded beam search. Not MCTS: no rollout policy, no learned value function.",
            "properties": {
              "branch": {
                "type": "integer",
                "minimum": 2,
                "maximum": 8,
                "default": 3
              },
              "depth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "default": 2
              },
              "score": {
                "type": "string"
              },
              "objective": {
                "enum": [
                  "min",
                  "max"
                ],
                "default": "max"
              },
              "prune": {
                "type": "string",
                "pattern": "^(none|beam\\([1-9][0-9]*\\))$"
              }
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "subgraph"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "ref"
              ],
              "not": {
                "required": [
                  "abilities"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "ref"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "subgraph"
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "human"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "approval"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "search"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "search"
              ]
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "flow",
              "error",
              "compensate"
            ],
            "default": "flow",
            "description": "v1.1 \u2014 error edges fire on `error` in node output; compensate edges are reverse paths exempt from back-edge lint and join accounting."
          }
        },
        "additionalProperties": false
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "v1.1 \u2014 blackboard keys supplied to the graph at entry."
        }
      },
      "additionalProperties": false
    },
    "termination": {
      "type": "object",
      "required": [
        "max_steps"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "contract": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "describe": {
            "type": "string",
            "description": "v1.1 \u2014 prose statement of what is being checked."
          },
          "assert": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "description": "v1.2 \u2014 evaluate against this subgraph phase's frame, not the final blackboard."
          }
        },
        "anyOf": [
          {
            "required": [
              "assert"
            ]
          },
          {
            "required": [
              "command"
            ]
          },
          {
            "required": [
              "describe"
            ]
          }
        ]
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "description": "v1.2 \u2014 where lessons written by this graph live.",
      "properties": {
        "scope": {
          "enum": [
            "run",
            "graph"
          ],
          "default": "run"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "description": "v1.3 \u2014 when this graph wants to run. AGR declares; it does not schedule. `agr triggers` emits the host-native artifact.",
      "items": {
        "type": "object",
        "required": [
          "on"
        ],
        "additionalProperties": false,
        "properties": {
          "on": {
            "enum": [
              "schedule",
              "webhook",
              "signal"
            ]
          },
          "cron": {
            "type": "string",
            "description": "schedule only; 5-field cron"
          },
          "source": {
            "type": "string",
            "description": "webhook only, e.g. github"
          },
          "event": {
            "type": "string",
            "description": "webhook only, e.g. pull_request"
          },
          "expr": {
            "type": "string",
            "description": "signal only; a condition over the blackboard"
          }
        }
      }
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "description": "v1.3 \u2014 journal frames so a killed run can resume.",
      "properties": {
        "checkpoint": {
          "enum": [
            "every_node",
            "never"
          ],
          "default": "never"
        },
        "resume": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "description": "v1.3 \u2014 ENFORCED caps. A recorded-but-unenforced limit is the anti-pattern this version exists to stop repeating.",
      "properties": {
        "usd_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "steps_max": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "additionalProperties": false
}
