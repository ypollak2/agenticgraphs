{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticgraphs.dev/spec/agr-graph.schema.json",
  "title": "AGR Graph v1.1",
  "type": "object",
  "required": [
    "apiVersion",
    "name",
    "description",
    "category",
    "nodes",
    "edges",
    "termination"
  ],
  "properties": {
    "apiVersion": {
      "enum": [
        "agr/v1",
        "agr/v1.1"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "category": {
      "enum": [
        "software-engineering",
        "devops-sre",
        "data-analytics",
        "research-knowledge",
        "content-marketing",
        "business-ops",
        "finance",
        "legal-compliance",
        "healthcare-science",
        "education",
        "customer-support-sales",
        "security",
        "hr-people",
        "logistics-retail",
        "creative-production"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "speciality"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$",
            "description": "A dot is reserved for subgraph expansion (`phase.child-node`); authored ids should not contain one."
          },
          "speciality": {
            "type": "string"
          },
          "abilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "enum": [
              "agent",
              "verifier",
              "human",
              "router",
              "subgraph"
            ],
            "default": "agent"
          },
          "parallel_group": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
            "description": "v1.1 — <category>/<graph-name> inlined at load time when kind is subgraph."
          },
          "join": {
            "type": "string",
            "pattern": "^(any|all|quorum\\([1-9][0-9]*\\))$",
            "default": "any",
            "description": "v1.1 — readiness rule over resolved incoming flow edges."
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "v1.1 — blackboard keys this node reads."
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "v1.1 — blackboard keys this node is contracted to write."
          },
          "on_error": {
            "type": "string",
            "description": "v1.1 — node id to route to when this node emits `error`; sugar for an error edge."
          },
          "retries": {
            "type": "object",
            "properties": {
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "backoff": {
                "enum": [
                  "none",
                  "linear",
                  "exponential"
                ],
                "default": "none"
              }
            },
            "required": [
              "max"
            ],
            "additionalProperties": false
          },
          "approval": {
            "type": "object",
            "properties": {
              "contract": {
                "type": "string"
              },
              "timeout": {
                "type": "string",
                "description": "Recorded but NOT enforced in v1.1 — the harness has no clock."
              },
              "on_timeout": {
                "enum": [
                  "escalate",
                  "reject",
                  "proceed"
                ],
                "default": "escalate"
              }
            },
            "required": [
              "contract"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "subgraph"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "ref"
              ],
              "not": {
                "required": [
                  "abilities"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "ref"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "subgraph"
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "human"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "approval"
              ]
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "flow",
              "error",
              "compensate"
            ],
            "default": "flow",
            "description": "v1.1 — error edges fire on `error` in node output; compensate edges are reverse paths exempt from back-edge lint and join accounting."
          }
        },
        "additionalProperties": false
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "v1.1 — blackboard keys supplied to the graph at entry."
        }
      },
      "additionalProperties": false
    },
    "termination": {
      "type": "object",
      "required": [
        "max_steps"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "contract": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "describe": {
            "type": "string",
            "description": "v1.1 — prose statement of what is being checked."
          },
          "assert": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "assert"
            ]
          },
          {
            "required": [
              "command"
            ]
          },
          {
            "required": [
              "describe"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
